        {
          "line": 19,
          "text": "title: ST_ClosestPoint"
        },
        {
          "line": 20,
          "text": "description: Returns the 2-dimensional point on geom1 that is closest to geom2."
        },
        {
          "line": 21,
          "text": "kernels:"
        },
        {
          "line": 22,
          "text": "  - returns: geometry"
        },
        {
          "line": 23,
          "text": "    args: [geometry, geometry]"
        },
        {
          "line": 24,
          "text": "  - returns: geography"
        },
        {
          "line": 25,
          "text": "    args: [geography, geography]"
        },
        {
          "line": 26,
          "text": "---"
        },
        {
          "line": 27,
          "text": ""
        },
        {
          "line": 28,
          "text": "## Examples"
        },
        {
          "line": 29,
          "text": ""
        },
        {
          "line": 30,
          "text": "```sql"
        },
        {
          "line": 31,
          "text": "SELECT ST_ClosestPoint("
        },
        {
          "line": 32,
          "text": "    ST_GeogFromText('LINESTRING(0 0, 10 10)'),"
        },
        {
          "line": 33,
          "text": "    ST_GeogPoint(5, 0)"
        },
        {
          "line": 34,
          "text": ");"
        },
        {
          "line": 35,
          "text": "```"
        }
      ]
